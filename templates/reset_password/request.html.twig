{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}  

   
    <div class="min-h-screen flex items-center justify-center login-gradient">
		<div class="bg-white p-8 rounded-lg shadow-xl w-full max-w-md">
			<div class="text-center mb-8">
				<h1 class="text-2xl font-bold text-gray-900 mt-4">Reinitialisation du mot de passe</h1>
				<p class="text-gray-600">
                    <small>
                       Entrer votre email pour reinitialiser votre mot de passe
                    </small>
                </p>
			</div>
             {{ form_start(requestForm) }}
                {{ form_row(requestForm.email) }}
                
               <button type="submit" class="w-full px-4 mt-5 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition flex items-center justify-center">
                    <i data-feather="log-in" class="mr-2"></i>
                    Envoyer
                </button>
            {{ form_end(requestForm) }}

		</div>
	</div>
{% endblock %}

{% block footer %}{% endblock %}
