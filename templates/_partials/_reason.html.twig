<section class="py-16 bg-gray-50">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-12">
			<h2 class="text-3xl font-bold text-gray-900 mb-4">Pourquoi choisir Bibliotech ?</h2>
			<p class="text-lg text-gray-600 max-w-2xl mx-auto">Une expérience de lecture moderne et simplifiée.</p>
		</div>

		<div
			class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Feature 1 -->
            {% for reason in reasons %}
            <div class="bg-white p-8 rounded-lg shadow-sm text-center">
                <div class="flex justify-center mb-4">
                    <div class="bg-indigo-100 p-4 rounded-full">
                        <i class="{{ reason.icon }} text-indigo-600"></i>
                    </div>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">{{ reason.title }}</h3>
                <p class="text-gray-600">{{ reason.description }}</p>
            </div>
            {% endfor %}
			

			
		</div>
	</div>
</section>
