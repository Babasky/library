{% if hero is defined and hero is not empty %}
    <section class="hero-gradient text-white py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="md:flex items-center justify-between">
                <div class="md:w-1/2 mb-10 md:mb-0">
                    <h1 class="text-4xl md:text-5xl font-bold mb-6">{{hero.title}}</h1>
                    <p class="text-xl mb-8">{{hero.subtitle}}</p>
                    <div class="flex space-x-4">
                        <a href="#" class="px-6 py-3 bg-white text-indigo-600 rounded-md font-medium hover:bg-gray-100 transition">Explorer
                            les livres
                        </a>
                        <a href="#" class="px-6 py-3 border border-white text-white rounded-md font-medium hover:bg-white hover:bg-opacity-10 transition">S'inscrire</a>
                    </div>
                </div>
                <div class="md:w-1/2 flex justify-center">
                    <img src="{{asset('uploads/images/'~hero.image)}}" alt="Person reading a book" class="rounded-lg shadow-xl max-w-full h-auto">
                </div>
            </div>
        </div>
    </section>
{% endif %}


