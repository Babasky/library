<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title> Library | {% block title %}Welcome!{% endblock %}</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://unpkg.com/feather-icons"></script>
        <link rel="stylesheet" href="{{asset('library/assets/css/style.css')}}">
        {% block stylesheets %}
        {% endblock %}
    </head>
    <body class="font-sans bg-gray-50">
        {% block header %}
            {% include "_partials/_header.html.twig" %}
        {% endblock %}
        {% block body %}{% endblock %}
        {% block footer %}
            {% include "_partials/_footer.html.twig" %}
        {% endblock %}
        {% block javascripts %}
            <script src="{{ asset('library/assets/js/script.js') }}"></script>
        {% endblock %}
    </body>
</html>
